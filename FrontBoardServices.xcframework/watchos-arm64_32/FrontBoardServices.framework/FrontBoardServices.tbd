--- !tapi-tbd
tbd-version:     4
targets:         [ armv7k-watchos, arm64-watchos, arm64e-watchos, arm64_32-watchos ]
install-name:    '/System/Library/PrivateFrameworks/FrontBoardServices.framework/FrontBoardServices'
swift-abi-version: 7
exports:
  - targets:         [ armv7k-watchos, arm64-watchos, arm64e-watchos, arm64_32-watchos ]
    symbols:              [  ]
    objc-classes:         [ FBSSceneDefinition,
    FBSMutableSceneDefinition,
    FBSSceneIdentity,
    FBSSceneClientIdentity,
    FBSSceneSettings,
    FBSMutableSceneSettings,
    FBSSettings,
    FBSSceneTransitionContext,
    FBSSceneSpecification,
    FBSSceneParameters,
    FBSSceneClientSettings,
    FBSMutableSceneClientSettings ]
    objc-ivars:           [  ]
...
